# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM: Google Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- NASA FIRMS active fires (free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# --- data.gov.in (free key: sign in at https://data.gov.in, then My Account -> API key)
DATA_GOV_IN_API_KEY=

# --- OpenAQ v3 (optional air-quality fallback, free key from https://explore.openaq.org/register)
OPENAQ_API_KEY=

# --- Database (local dev uses the Docker PostGIS in infra/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://blindspot:blindspot@localhost:5433/blindspot
